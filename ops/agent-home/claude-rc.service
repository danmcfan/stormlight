# Claude Code Remote Control for ~/code: drive it from the Claude desktop and
# mobile apps or claude.ai/code. Sessions start in ~/code, where every repo is
# cloned, so each one can work in any of them. Not ~ itself: Claude Code never
# saves trust for a home folder, so the service would stop at the trust prompt
# on every start. Installed by setup.sh as a user unit, so agent can edit and
# restart it without root.
[Unit]
Description=Claude Code Remote Control (~/code)
After=network-online.target

[Service]
WorkingDirectory=%h/code
Environment=PATH=%h/.local/bin:/run/wrappers/bin:/run/current-system/sw/bin
# remote-control is a TUI, so script(1) gives it a terminal.
ExecStart=/run/current-system/sw/bin/script -qfec "%h/.local/bin/claude remote-control --name agent-box --spawn=same-dir --capacity 6 --permission-mode bypassPermissions" /dev/null
Restart=always
RestartSec=10
# Inside user-1000.slice's 5G soft / 6G hard cap; this leaves Cursor and Rex
# some room when the sessions are busy.
MemoryHigh=4G
MemoryMax=5G

[Install]
WantedBy=default.target
